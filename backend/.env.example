# PLACEHOLDER ONLY — not valid on Vultr.
# Copy to backend/.env and replace with your real local or staging credentials.
# Never commit real passwords. Never put secrets in NEXT_PUBLIC_*.
# Production: migrate/bootstrap as yoyknowmail_app; long-running service as yoyknowmail_runtime.
# See deploy/ENV.md and deploy/ROLES.md.
DATABASE_URL=postgresql://USER:CHANGE_ME@127.0.0.1:5432/yoyknowmail

# Comma-separated browser origins allowed for CORS + cookies
FRONTEND_ORIGINS=http://localhost:3000

# Cookie settings (COOKIE_SECURE=true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
TEMP_TOKEN_TTL_MINUTES=10

# development | test | production
# production => migrate defaults to --profile production (no local DROP baselines)
APP_ENV=development
MAIL_DOMAIN=yoyknowmail.com
BULK_MAILBOX_LIMIT=100
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Optional Fernet/material for TOTP secret at-rest obfuscation
TOTP_ENCRYPTION_KEY=

# Bootstrap CLI only — do not leave set on the long-running service
# BOOTSTRAP_ADMIN_PASSWORD=
