[Unit]
Description=YoyKnowMail authenticated FastAPI app (separate from yoyknowmail-api ingestion)
Documentation=file:///opt/yoyknowmail-app/deploy/README.md
After=network.target postgresql.service
Wants=postgresql.service
# Do not Conflict with or replace yoyknowmail-api (127.0.0.1:8000).

[Service]
Type=simple
User=yoyknowmail
Group=yoyknowmail
WorkingDirectory=/opt/yoyknowmail-app
EnvironmentFile=/opt/yoyknowmail-app/.env
Environment=PYTHONUNBUFFERED=1
# Bind only loopback; Nginx terminates TLS and proxies here.
# DATABASE_URL in .env should use yoyknowmail_runtime (not the migration role).
ExecStart=/opt/yoyknowmail-app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yoyknowmail-app

[Install]
WantedBy=multi-user.target
