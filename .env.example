# Browser-facing API base for the authenticated app API (not /inbound).
# Never put PostgreSQL credentials, ingestion secrets, or admin tokens here.
#
# Option A — same-origin proxy (preferred for secure cookies):
#   NEXT_PUBLIC_API_BASE_URL=/api/backend
#   API_PROXY_TARGET=https://mail.yoyknowmail.com
#
# Option B — direct cross-origin (backend must allow your origin + SameSite=None):
NEXT_PUBLIC_API_BASE_URL=https://mail.yoyknowmail.com

# Server-only rewrite target used when NEXT_PUBLIC_API_BASE_URL=/api/backend
# API_PROXY_TARGET=https://mail.yoyknowmail.com
